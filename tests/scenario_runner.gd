	var bush_far := _tut20_flat_distance(Quests._target("berries"), player.global_position)
	_check(rock_far < 15.0 and bush_far < 15.0, "from there the stone's dot is %.0f m away and the berries' %.0f m" % [rock_far, bush_far])
