	board._coop_pick = ""
	board.close_screen()
	SaveGame.delete(slot)
	tidy.call()


## The text of a tag on the board (a price or a lock), freed after.
func _chip_text(chip: Control) -> String:
	var out := PackedStringArray()
	for l in chip.find_children("*", "Label", true, false):
		out.append((l as Label).text)
	chip.free()
	return " ".join(out)


## The expansion's ENLARGE button on the board (null when it isn't shown).
func _expand_button(board: BuildScreen) -> Button:
	var label := UiTheme.caps(tr("BUILD_EXPAND"))
	for b in board._detail.find_children("*", "Button", true, false):
		if not b.is_queued_for_deletion() and (b as Button).text == label:
			return b
	return null


## Every label's text on the board's detail, one per line.
func _board_text(board: BuildScreen) -> String:
	var out := PackedStringArray()
	for l in board._detail.find_children("*", "Label", true, false):
		if not l.is_queued_for_deletion() and not l.get_parent().is_queued_for_deletion():
			out.append((l as Label).text)
	return "\n".join(out)


## The coops' rows in the expansion's list, in order.
func _coop_rows(board: BuildScreen) -> Array[Control]:
	var out: Array[Control] = []
	for c in board._detail.find_children("Coop*", "Control", true, false):
		if not c.is_queued_for_deletion():
			out.append(c as Control)
	return out


## Width (X) of a coop's house model, roof overhangs and all.
func _coop_mesh_width(h: AnimalHousing) -> float:
	var mi := h.get_node_or_null("Structure/Building")
	if mi == null:
		return 0.0
	for c in mi.get_children():
		if c is MeshInstance3D and (c as MeshInstance3D).cast_shadow != GeometryInstance3D.SHADOW_CASTING_SETTING_OFF:
			return (c as MeshInstance3D).mesh.get_aabb().size.x
	return 0.0


## A wolf hunting a hen at the far end of the longer coop at night (the birds stay in):
## kept out by the shut door and the walls; with the door open, it goes in by the door.
func _coop_expand_wolf(coop: ChickenCoop) -> void:
	var h := coop.housing
	var hour := GameClock.get_hour_float()
	var ran := GameClock.running
	GameClock.running = false
	GameClock.set_time_of_day(22.5)
	var hen: Animal = null
	for n in h.animals:
		if n.data.species == &"chicken" and n.data.adult and not n.data.is_chick():
			hen = n
	if hen == null:
		_check(false, "a hen for the wolf")
		GameClock.set_time_of_day(hour)
		GameClock.running = ran
		return
	for n in h.animals:
		n.teleport_home(true)
	h.door.set_open(false, false)
	var end := h.frame * Vector3(h.building.end.x - 0.9, 0.0, h.building.get_center().y + 0.4)
	end.y = h.floor_height()
	hen.global_position = end
	hen.indoors = true
	hen.reset_physics_interpolation()
	_check(not WolfRaids.can_reach(hen.data), "the door shut: the hen at the far end is out of the wolves' reach")
	var wolf := Wolf.spawn(Game.world, h.door_outside() + h.front() * 12.0)
	wolf.set_goal(&"hunt", hen)
	Engine.time_scale = 2.0
	var into := 0.0
	var t := 0.0
	while t < 12.0:
		await _frames(6)
		t += 0.1
		if h.is_in_building(wolf.global_position) or Wolf.in_building(wolf.global_position, null):
			into += 0.1
	_check(into < 0.01 and hen.data.health > 0.0 and not hen.data.injured(), "shut, the wolf stays outside the longer house (%.1f s in it)" % into)
	# Behind the middle of the long house, where it has the furthest way round.
	wolf.global_position = h.world_at(h.building.get_center().x, h.building.position.y - 0.6)
	wolf.reset_physics_interpolation()
	await _frames(2)
	h.door.set_open(true, false)
	_check(WolfRaids.can_reach(hen.data), "the door open: she can be reached")
	var by_door := false
	var in_by_door := false
	var through_wall := false
	var reached := false
	t = 0.0
	var last := h.flat(wolf.global_position)
	while t < 25.0 and not reached:
		await _frames(1)
		t += 1.0 / 60.0
		var wp := wolf.global_position
		var l := h.flat(wp)
		if wp.distance_to(h.door_outside()) < 1.2:
			by_door = true
		if h.building.has_point(l) and not h.building.has_point(last):
			# Came in: across the front wall in the doorway, never through a wall.
			var front := h.building.end.y
			if last.y > front and l.y <= front and absf(lerpf(last.x, l.x, (front - last.y) / (l.y - last.y)) - h.door_x()) < 0.8:
				in_by_door = true
			else:
				through_wall = true
		last = l
		if h.building.has_point(l) and (not is_instance_valid(hen) or hen.data.health <= 0.0 or hen.data.injured()
				or _flat_dist(wp, hen.global_position) < 1.3):
			reached = true
	Engine.time_scale = 1.0
	GameClock.set_time_of_day(hour)
	GameClock.running = ran
	_check(reached and by_door and in_by_door and not through_wall,
			"open, the wolf behind the house goes round it, in by the door and gets to her (%.1f s; by the door %s, in by it %s)"
			% [t, by_door, in_by_door])
	wolf.queue_free()
	await _frames(3)


# --- The fishing contest ---------------------------------------------------------------------

## The fishing contest (FishingContest, ContestVenue, ContestCrowd): its days (every fourth,
## two days off each carnival), Nuri Hoca's letter the day before, the anglers and the crowd at the town pond
## during it and back home after, the player's fish weighed there (not at the farm pond),
## the board kept over a save and load, the ceremony, the prize when he wins and none when
## a rival does. With -- --contest-shots=/abs/dir it saves the venue, the board and the
## applause.
func _contest() -> void:
	var player: Player = Game.player
	var town := tree.get_first_node_in_group(&"town") as Town
	var venue := town.get_node_or_null("ContestVenue") as ContestVenue
	var crowd := venue.get_node_or_null("ContestCrowd") as ContestCrowd if venue else null
	await _contest_ready_player(player)
	var kept_day := GameClock.day
	var kept_minute := GameClock.minute
	var kept_money := Economy.money
	var far := Vector3(-14.0, 0.2, -9.0)
	FishingContest.testing = true
	FishingContest.ceremony_speed = 4.0
	_check(venue != null and crowd != null, "the town has its contest venue (pond, board, benches) and crowd")
	if venue == null or crowd == null:
		return
	var days: Array[int] = []
	for d in range(1, 50):
		if FishingContest.is_contest_day(d):
			days.append(d)
	var off_carnival := true
	for d: int in days:
		off_carnival = off_carnival and not Carnival.is_carnival_day(d) and Carnival.is_carnival_day(d - 2)
	_check(days == [6, 10, 14, 18, 22, 26, 30, 34, 38, 42, 46] and off_carnival,
			"a contest on day 6, then every 4 days, always two days after a carnival (%s)" % str(days))
	# The first two contest days.
	var k1 := FishingContest.FIRST_DAY
	var k2 := k1 + FishingContest.EVERY_DAYS
	var c := WorldLayout.TOWN_POND_CENTER
	_check(Pond.is_fishable(Vector3(c.x, 0.0, c.y)) and Pond.is_fishable(Vector3(c.x - 5.0, 0.0, c.y))
			and not Pond.is_fishable(Vector3(c.x, 0.0, c.y - 12.0)), "the town pond is deep enough to fish in, its bank is dry")
	_check(venue.angler_spots.size() == 5 and venue.bench_seats.size() == 2 and venue.crowd_spots.size() >= 2,
			"the venue has places for five anglers, two benches and the crowd")

	# --- Nuri Hoca's letter: the morning before a contest only ---
	FishingContest.letter_day = 0
	var letters: Array[int] = []
	var shown := false
	for d: int in [k1 - 2, k1 - 1, k1, k2 - 2, k2 - 1]:
		GameClock.day = d
		GameClock.minute = float(GameClock.DAY_START_MINUTE)
		Events.day_started.emit(d)
		if FishingContest.letter_pending:
			letters.append(d)
			FishingContest.open_letter()
			await _idle_frames(2)
			var screen: LetterScreen = Game.hud.letter_screen
			var text := PackedStringArray()
			for l in screen.find_children("*", "Label", true, false):
				text.append((l as Label).text)
			var all := " ".join(text)
			shown = screen.visible and all.contains("09:00") and all.contains("17:00") and all.contains("$100")
			screen.hide_screen()
			await _idle_frames(1)
	_check(letters == [k1 - 1, k2 - 1], "the letter comes the morning before a contest (%s)" % str(letters))
	_check(shown, "it tells the hours (09:00 to 17:00) and the $100 prize")

	# --- The first contest: the town goes to the pond ---
	var ids: Array[StringName] = [&"young", &"farmer", &"villager", &"sweeper", &"elder", &"teacher"]
	var home := {}
	var acts := {}
	for id in ids:
		var p := crowd.person(id)
		home[id] = p.global_position
		acts[id] = p.act
	player.global_position = far
	GameClock.day = k1
	GameClock.minute = 8.0 * 60.0 + 50.0
	Events.day_started.emit(k1)
	await _seconds(0.8)
	_check(not FishingContest.is_on() and not crowd.is_gathered(), "before 09:00 nobody is at the pond")
	GameClock.minute = 9.0 * 60.0 + 1.0
	await _seconds(1.2)
	var anglers_ok := true
	for id: StringName in ContestCrowd.ANGLERS:
		var p := crowd.person(id)
		var d := Vector2(p.global_position.x, p.global_position.z).distance_to(c) if p else INF
		if p == null or p.act != Townsperson.Act.FISH or d > WorldLayout.TOWN_POND_RADIUS + 3.0:
			anglers_ok = false
	_check(FishingContest.is_on() and crowd.is_gathered() and anglers_ok, "at 09:00 five anglers fish at the pond (round its shore)")
	var seated_ok := true
	for id: StringName in [&"elder", &"teacher"]:
		var p := crowd.person(id)
		if p.act != Townsperson.Act.BENCH or Vector2(p.global_position.x, p.global_position.z).distance_to(c) > WorldLayout.TOWN_POND_RADIUS + 6.0:
			seated_ok = false
	_check(seated_ok and crowd.people().size() == 9 + EventCrowd.WORKERS.size(),
			"Osman Dede and Nuri Hoca watch from the benches, the visitors and the workers stand by (%d there)" % crowd.people().size())
	_check(crowd.person(&"shopkeeper").away and (town.market_counter as TownPoint).hint_prompt() == tr("HINT_SERVICE_AWAY"),
			"Hasan comes too; his counter still opens (the honesty box)")
	# The rivals land fish as the hours pass.
	for i in 18:
		GameClock.minute += 10.0
		await _idle_frames(2)
	_check(FishingContest.entries.size() >= 3, "the rivals' fish are weighed (%d on the board)" % FishingContest.entries.size())

	# --- The player's fish: weighed at the town pond only ---
	_check(not FishingContest.player_caught(&"fish_carp", 9.0, Vector3(-44.0, 0.0, 4.0)), "a fish from the farm pond doesn't count")
	var bank: Vector3 = venue.crowd_spots[0]["pos"]
	player.global_position = bank + Vector3(0.0, 0.4, 0.0)
	await _seconds(0.8)
	var card := Game.hud.find_child("ContestCard", true, false) as Control
	_check(card != null and card.visible, "at the pond a small card shows the contest's board")
	var counted := FishingContest.player_caught(&"fish_bream", 1.5, player.global_position)
	FishingContest.player_caught(&"fish_roach", 0.4, player.global_position)
	var best := float((FishingContest.entries.get("player", {}) as Dictionary).get("kg", 0.0))
	_check(counted and is_equal_approx(best, 1.5), "his fish landed there is weighed, the biggest counts (%.2f kg)" % best)
	_check(FishingContest.board_text().contains(tr("CONTEST_YOU")), "the board lists him")
	if String(DebugTools.args.get("contest-shots", "")) != "":
		await _contest_shots(String(DebugTools.args["contest-shots"]), venue, crowd)
	# Saved and loaded in the middle of it: the board is kept.
	var n := FishingContest.entries.size()
	var saved := FishingContest.save_data()
	FishingContest.entries.clear()
	FishingContest.load_data(saved)
	_check(FishingContest.entries.size() == n and is_equal_approx(float(FishingContest.entries["player"]["kg"]), 1.5),
			"a save and load in the middle of it keeps the board")

	# --- 17:00, a rival wins: the ceremony, no prize, everyone home again ---
	for id: StringName in FishingContest.RIVALS:
		FishingContest._next_catch[String(id)] = 99999.0
	for k: String in FishingContest.entries.keys():
		if k != "player":
			FishingContest.entries[k]["kg"] = minf(float(FishingContest.entries[k]["kg"]), 1.0)
	FishingContest.entries["young"] = {"kg": 3.2, "fish": "fish_carp"}
	var money := Economy.money
	var fish := PlayerState.inventory.count_item(FishingContest.PRIZE_FISH_ID)
	var had_ach := Achievements.is_unlocked(FishingContest.ACHIEVEMENT)
	player.global_position = bank + Vector3(0.0, 0.4, 0.0)
	await _idle_frames(2)
	GameClock.minute = 17.0 * 60.0 + 0.5
	await _seconds(0.5)
	var clapping := 0
	for p: Townsperson in crowd.people():
		if p.is_clapping():
			clapping += 1
	_check(clapping >= 7, "the horn: the crowd and the anglers applaud (%d clapping)" % clapping)
	# Out of sight when they leave (they are put back at once, not walked).
	player.global_position = far
	await _contest_wait_finished()
	_check(String(FishingContest.last_winner.get("id", "")) == "young" and Economy.money == money
			and PlayerState.inventory.count_item(FishingContest.PRIZE_FISH_ID) == fish
			and Achievements.is_unlocked(FishingContest.ACHIEVEMENT) == had_ach,
			"Emre's 3.2 kg carp wins: no prize for the player")
	await _seconds(1.0)
	var back := true
	for id in ids:
		var p := crowd.person(id)
		# (a walker is back on his round and already on his way again)
		var slack := 3.0 if acts[id] == Townsperson.Act.WALK else 0.6
		if p.global_position.distance_to(home[id]) > slack or p.act != acts[id]:
			back = false
	_check(back and not crowd.is_gathered() and town.get_node_or_null("TownPeople/Person_fisher") == null,
			"then everyone goes back to what they were doing, the visitors leave")

	# --- The second contest: the player wins ---
	GameClock.day = k2
	GameClock.minute = 8.0 * 60.0 + 59.0
	Events.day_started.emit(k2)
	await _seconds(0.6)
	GameClock.minute = 9.0 * 60.0 + 1.0
	await _seconds(1.2)
	_check(crowd.is_gathered() and not FishingContest.entries.has("player"), "the next contest starts with a fresh board")
	for id: StringName in FishingContest.RIVALS:
		FishingContest._next_catch[String(id)] = 99999.0
		FishingContest.entries[String(id)] = {"kg": 0.8, "fish": "fish_perch"}
	player.global_position = bank + Vector3(0.0, 0.4, 0.0)
	await _idle_frames(2)
	FishingContest.player_caught(&"fish_pike", 6.4, player.global_position)
	money = Economy.money
	fish = PlayerState.inventory.count_item(FishingContest.PRIZE_FISH_ID) + FarmState.warehouse.count(FishingContest.PRIZE_FISH_ID)
	Achievements.unlocked.erase(FishingContest.ACHIEVEMENT)
	Economy.ledger.clear()
	GameClock.minute = 17.0 * 60.0 + 0.5
	await _contest_wait_finished()
	var got := PlayerState.inventory.count_item(FishingContest.PRIZE_FISH_ID) + FarmState.warehouse.count(FishingContest.PRIZE_FISH_ID) - fish
	var prize_line := Economy.close_day()["lines"].get("REPORT_PRIZE", 0) as int
	_check(String(FishingContest.last_winner.get("id", "")) == "player" and Economy.money == money + FishingContest.PRIZE_MONEY
			and prize_line == FishingContest.PRIZE_MONEY, "his 6.4 kg pike wins: $100 prize money, in the report as a prize")
	_check(got == FishingContest.PRIZE_FISH and Achievements.is_unlocked(FishingContest.ACHIEVEMENT),
			"and 20 fish and the Best Angler achievement (%d fish)" % got)
	await _seconds(0.6)
	_check(Economy.money == money + FishingContest.PRIZE_MONEY, "the prize comes once")
	_check(FishingContest.board_text().contains(tr("CONTEST_YOU")) and not FishingContest.is_on(), "the board names him the last winner")

	player.global_position = far
	await _seconds(1.0)
	FishingContest.testing = false
	FishingContest.ceremony_speed = 1.0
	GameClock.day = kept_day
	GameClock.minute = kept_minute
	Economy.money = kept_money
	await _seconds(0.6)


func _contest_ready_player(player: Player) -> void:
	for i in 8:
		if not Game.hud.sleep_screen.is_busy():
			break
		Game.hud.sleep_screen.confirm()
		await _frames(3)
	for n in Game.hud.find_children("*", "ModalScreen", true, false):
		if (n as ModalScreen).visible:
			(n as ModalScreen).hide_screen()
	if player.driving:
		player.exit_vehicle()


func _contest_wait_finished() -> void:
	for i in 60:
		if FishingContest.result_day == GameClock.day and not FishingContest.crowd_out():
			return
		await _seconds(0.25)


## The venue with the anglers and the crowd (Emre holding up a fish), the board, and the
## applause at the horn.
func _contest_shots(dir: String, venue: ContestVenue, crowd: ContestCrowd) -> void:
	DirAccess.make_dir_recursive_absolute(dir)
	var player: Player = Game.player
	var c := WorldLayout.TOWN_POND_CENTER
	var eye := Vector3(c.x + 9.5, 0.0, c.y - 15.5)
	eye.y = TerrainData.height(eye.x, eye.z) + 0.2
	player.global_position = eye
	var to := Vector3(c.x - 1.0, 0.0, c.y - 3.0) - eye
	player.look_at_yaw_pitch(atan2(-to.x, -to.z), deg_to_rad(-9.0))
	await _seconds(1.0)
	FishingContest.rival_caught.emit(&"young", FishTable.catch_of(&"fish_carp", 0.7))
	await _seconds(1.0)
	await _shot(dir + "/contest_venue.png")
	var board := venue.get_node("BoardText") as Label3D
	var front := board.global_transform.basis.z
	var at := board.global_position + front * 2.3
	at.y = TerrainData.height(at.x, at.z) + 0.2
	player.global_position = at
	player.look_at_yaw_pitch(atan2(front.x, front.z), deg_to_rad(-6.0))
	await _shot(dir + "/contest_board.png")
	player.global_position = eye
	player.look_at_yaw_pitch(atan2(-to.x, -to.z), deg_to_rad(-9.0))
	await _seconds(0.5)
	var speed := FishingContest.ceremony_speed
	var minute := GameClock.minute
	var saved := FishingContest.save_data()
	FishingContest.ceremony_speed = 1.0
	FishingContest._start_ceremony()
	await _seconds(0.3)
	await _shot(dir + "/contest_applause.png")
	# Back as it was: the contest still on, the crowd back at its places.
	FishingContest._ceremony_t = -1.0
	FishingContest.load_data(saved)
	FishingContest.ceremony_speed = speed
	GameClock.minute = minute
	player.global_position = Vector3(-14.0, 0.2, -9.0)
	for p: Townsperson in crowd.people():
		p.clap(0.0)
		if p.act == Townsperson.Act.CLAP:
			p.act = Townsperson.Act.STAND
	await _seconds(0.6)



## Round 17 at the fishing contest: the side goal and its dot on a contest day (done at the
## venue); no pier, the anglers spread round the shore facing the water and the player able
## to fish from the bank anywhere round it; the walkers' ways in and out round the board,
## the benches and the water; a cheer at each new biggest fish (the player's too); the shop
## boy's broom in his hand while he walks, on the grass while he fishes. With
## -- --contest17-shots=/abs/dir it saves the venue during the contest and the boy walking.
func _contest17() -> void:
	var player: Player = Game.player
	var town := tree.get_first_node_in_group(&"town") as Town
	var venue := town.get_node_or_null("ContestVenue") as ContestVenue
	var crowd := venue.get_node_or_null("ContestCrowd") as ContestCrowd if venue else null
	await _contest_ready_player(player)
	var shots := String(DebugTools.args.get("contest17-shots", ""))
	if shots != "":
		DirAccess.make_dir_recursive_absolute(shots)
	var kept_day := GameClock.day
	var kept_minute := GameClock.minute
	var far := Vector3(-14.0, 0.2, -9.0)
	FishingContest.testing = true
	FishingContest.ceremony_speed = 4.0
	_check(venue != null and crowd != null, "contest17: the town has its contest venue and crowd")
	if venue == null or crowd == null:
		return
	var c := WorldLayout.TOWN_POND_CENTER
	var space := player.get_world_3d().direct_space_state
	var wall := venue.pond.shore_wall()

	# --- No pier: the ring round the pond closed, nothing standing out over the water ---
	var over := 0
	for i in 48:
		var a := TAU * i / 48.0
		for r: float in [1.5, 4.0, 6.5]:
			var p := Vector3(c.x + cos(a) * r, 0.0, c.y + sin(a) * r)
			var q := PhysicsRayQueryParameters3D.create(Vector3(p.x, WorldLayout.WATER_LEVEL + 3.0, p.z), Vector3(p.x, WorldLayout.WATER_LEVEL + 0.03, p.z), 1)
			q.exclude = [wall.get_rid()]
			if not space.intersect_ray(q).is_empty():
				over += 1
	_check(venue.pond.wall_gap.is_empty() and over == 0, "contest17: no pier: the shore ring is closed and nothing stands over the water (%d hits)" % over)

	# --- The anglers round the shore, facing the water, the floats on fishable water ---
	var angles: Array[float] = []
	var facing := true
	var fishable := true
	var on_bank := true
	for s: Dictionary in venue.angler_spots:
		var at: Vector3 = s["pos"]
		var d := Vector2(at.x - c.x, at.z - c.y)
		angles.append(fposmod(d.angle(), TAU))
		var look := Vector2(sin(float(s["yaw"])), cos(float(s["yaw"])))
		facing = facing and look.dot(-d.normalized()) > 0.97
		fishable = fishable and Pond.is_fishable(s["water"])
		var shore := Pond.shore_radius(c, WorldLayout.TOWN_POND_RADIUS, d.normalized())
		on_bank = on_bank and TerrainData.height(at.x, at.z) > WorldLayout.WATER_LEVEL and d.length() - shore < 1.5
	angles.sort()
	var gaps: Array[float] = []
	for i in angles.size():
		gaps.append(fposmod(angles[(i + 1) % angles.size()] - angles[i], TAU))
	_check(venue.angler_spots.size() == 5 and gaps.min() > 0.95 and gaps.max() < 1.6,
			"contest17: five anglers spread round the pond (gaps %s rad)" % str(gaps.map(func(g: float) -> String: return "%.2f" % g)))
	_check(on_bank and facing and fishable, "contest17: each stands on the bank facing the water, his float on fishable water")
	# Their places, the crowd's and the benches' are clear of anything solid (trees, posts).
	var blocked: Array[String] = []
	var ball := SphereShape3D.new()
	ball.radius = 0.28
	var sq := PhysicsShapeQueryParameters3D.new()
	sq.shape = ball
	sq.collision_mask = 1
	sq.exclude = [wall.get_rid()]
	for list: Array in [venue.angler_spots, venue.crowd_spots]:
		for s: Dictionary in list:
			var at: Vector3 = s["pos"]
			sq.transform = Transform3D(Basis(), Vector3(at.x, TerrainData.height(at.x, at.z) + 1.1, at.z))
			if not space.intersect_shape(sq, 1).is_empty():
				blocked.append("%.1f,%.1f" % [at.x, at.z])
	_check(blocked.is_empty(), "contest17: nothing solid where the anglers and the crowd stand %s" % str(blocked))
	# The player can fish from the bank anywhere round it: from where he can stand, a cast
	# towards the middle comes down on fishable water, nothing in its way.
	var dry: Array[String] = []
	for i in 24:
		var dir := Vector2.from_angle(TAU * i / 24.0)
		var stand_r := maxf(Pond.shore_radius(c, WorldLayout.TOWN_POND_RADIUS, dir) + 0.2, WorldLayout.TOWN_POND_RADIUS - 0.9 + 0.5)
		var at := c + dir * stand_r
		var ok := false
		for d: float in [3.0, 4.0, 5.0, 6.0]:
			var w := c + dir * (stand_r - d)
			if not Pond.is_fishable(Vector3(w.x, 0.0, w.y)):
				continue
			var from := Vector3(at.x, TerrainData.height(at.x, at.y) + 1.6, at.y)
			var q := PhysicsRayQueryParameters3D.create(from, Vector3(w.x, WorldLayout.WATER_LEVEL + 0.1, w.y), 1)
			q.exclude = [wall.get_rid()]
			if space.intersect_ray(q).is_empty():
				ok = true
				break
		if not ok:
			dry.append("%d°" % (i * 15))
	_check(dry.is_empty(), "contest17: from the bank anywhere round the pond a cast lands in the water %s" % str(dry))

	# --- The ways in and out: round the board and the benches, never through the water ---
	var places: Array = []
	for list: Array in [venue.angler_spots, venue.crowd_spots, venue.bench_seats]:
		for s: Dictionary in list:
			places.append(s["pos"])
	places.append(crowd.zeynep_spot()["pos"])
	var bad: Array[String] = []
	for to: Vector3 in places:
		var way: Array[Vector3] = []
		way.assign(venue.approach)
		way.append_array(venue.path_in(to))
		way.append(to)
		var why := _c17_way_clear(venue, way, space, sq, to)
		if why != "":
			bad.append("in to %.1f,%.1f: %s" % [to.x, to.z, why])
		var back: Array[Vector3] = [to]
		back.append_array(venue.path_out(to))
		back.append(venue.approach[venue.approach.size() - 1])
		why = _c17_way_clear(venue, back, space, sq, to)
		if why != "":
			bad.append("out from %.1f,%.1f: %s" % [to.x, to.z, why])
	_check(bad.is_empty() and venue.footprints.size() == 3, "contest17: every way in and out goes round the board and the benches, on dry ground %s" % str(bad))

	# --- The side goal: the morning of the first contest, its dot over the pond ---
	FishingContest.goal_day = 0
	FishingContest.result_day = 0
	player.global_position = far
	GameClock.day = FishingContest.FIRST_DAY
	GameClock.minute = 8.0 * 60.0
	Events.day_started.emit(FishingContest.FIRST_DAY)
	await _seconds(1.2)
	var g := FishingContest.goal()
	var dot: Variant = g.guide_point()
	_check(FishingContest.goal_up() and g.text == tr("SIDE_GOAL_CONTEST") and dot is Vector3
			and Vector2((dot as Vector3).x, (dot as Vector3).z).distance_to(c) < 1.0 and not g.quiet,
			"contest17: on the contest morning a side goal comes up, its dot over the town pond (the first one prominent)")
	_check(SideStory.goals.has(g) and g.hint == tr("SIDE_HINT_CONTEST_SOON") % "09:00", "contest17: it says when it starts (%s)" % g.hint)

	# --- The shop boy walks: his broom stays in his left hand ---
	var boy := crowd.person(&"sweeper")
	var line := boy.sweep_to - boy.sweep_from
	line.y = 0.0
	var along := line.normalized()
	var mid := boy.sweep_from + line * 0.5
	# From one end of his forecourt to the other and back (a walk, not his sweeping).
	var walk: Array[Vector3] = [boy.sweep_from + along * 0.3, boy.sweep_to - along * 0.3]
	if boy.global_position.distance_to(walk[0]) < boy.global_position.distance_to(walk[1]):
		walk.reverse()
	# Watching from the pavement in front of the market (the street's side).
	var side := Vector3(-along.z, 0.0, along.x)
	if side.z * (Town.STREET_Z - mid.z) < 0.0:
		side = -side
	player.global_position = mid + side * 4.2 + Vector3(0, 0.3, 0)
	var to_mid := mid + Vector3(0, 0.9, 0) - player.global_position - Vector3(0, 1.6, 0)
	player.look_at_yaw_pitch(atan2(-to_mid.x, -to_mid.z), asin(clampf(to_mid.normalized().y, -1.0, 1.0)))
	await _seconds(0.6)
	boy.walk_to(walk, func() -> void:
		boy.act = Townsperson.Act.SWEEP
		boy._sweep_s = clampf((boy.global_position - boy.sweep_from).dot(along), 0.0, line.length()))
	var worst := 0.0
	var shown := true
	var samples := 0
	var shot_taken := false
	for k in 400:
		await _idle_frames(1)
		if boy.act != Townsperson.Act.WALK:
			break
		if boy._speed < 0.3:
			continue
		samples += 1
		var off := _c17_broom_off(boy)
		shown = shown and off < INF
		worst = maxf(worst, off if off < INF else 0.0)
		if shots != "" and not shot_taken and samples > 40:
			shot_taken = true
			await _shot(shots + "/contest17_sweeper_walking.png")
	_check(samples >= 20 and shown and worst < 0.035,
			"contest17: walking, the shop boy carries his broom in his hand (%d frames, fist at most %.3f m off the handle)" % [samples, worst])
	await _seconds(1.0)

	# --- 09:00: the anglers on the shore, his broom on the grass, the tea glass left behind ---
	# (far off first: the camera catches up before they set off, so they are simply there)
	player.global_position = far
	await _seconds(1.0)
	GameClock.minute = 9.0 * 60.0 + 1.0
	await _seconds(1.5)
	_check(FishingContest.goal_up() and g.hint == tr("SIDE_HINT_CONTEST_ON") % "17:00", "contest17: while it is on, the goal stays up until he comes (%s)" % g.hint)
	_check(FishingContest.crowd_level() > 0.0 and Audio._set_paths(Audio.SETS["crowd_cheer"]).size() == 2
			and Audio._set_paths(Audio.SETS["crowd_call"]).size() >= 3 and Audio.LOOPS.has("contest_crowd"),
			"contest17: the crowd's murmur plays over the pond, calls and cheers are there to play")
	var anglers_ok := true
	for i in ContestCrowd.ANGLERS.size():
		var p := crowd.person(ContestCrowd.ANGLERS[i])
		var spot: Dictionary = venue.angler_spots[i]
		if p == null or p.act != Townsperson.Act.FISH or p.global_position.distance_to(spot["pos"]) > 0.3:
			anglers_ok = false
	_check(anglers_ok, "contest17: the five anglers fish from their places on the shore")
	var bank: Vector3 = venue.crowd_spots[0]["pos"]
	player.global_position = bank + Vector3(0.0, 0.4, 0.0)
	await _seconds(1.2)
	_check(not FishingContest.goal_up() and FishingContest.goal_day == FishingContest.FIRST_DAY and not SideStory.goals.has(g),
			"contest17: at the pond the side goal is done")
	# (close enough to the boy for him to be drawn)
	var bp := boy.global_position
	player.global_position = bp + (Vector3(c.x, bp.y, c.y) - bp).normalized() * -4.0 + Vector3(0, 0.4, 0)
	await _seconds(0.8)
	var bx := boy._prop.global_transform if boy._prop else Transform3D()
	var hand := boy.rig.to_global(boy.rig.grip_point("_l"))
	var ground := TerrainData.height(bx.origin.x, bx.origin.z)
	_check(boy._prop != null and boy._prop.visible and absf(bx.origin.y - ground) < 0.06 and absf(bx.basis.y.normalized().y) < 0.2
			and hand.distance_to(bx.origin) > 0.3, "contest17: fishing, his broom lies on the grass beside him (%.3f m off the ground)" % (bx.origin.y - ground))
	var teacher := crowd.person(&"teacher")
	_check(teacher.act == Townsperson.Act.BENCH and teacher._prop and not teacher._prop.visible, "contest17: Nuri Hoca left his tea glass behind")

	# --- A new biggest fish: a cheer (the rivals' and the player's), not for a smaller one ---
	var leaders: Array[String] = []
	var on_leader := func(who: String, _kg: float) -> void: leaders.append(who)
	FishingContest.new_leader.connect(on_leader)
	for id: StringName in FishingContest.RIVALS:
		FishingContest._next_catch[String(id)] = 99999.0
	FishingContest.entries.clear()
	FishingContest.record("young", {"id": &"fish_carp", "kg": 1.2})
	await _seconds(0.3)
	var cheering := 0
	for p: Townsperson in crowd.people():
		if p.is_cheering() or p.is_clapping():
			cheering += 1
	FishingContest.record("farmer", {"id": &"fish_perch", "kg": 0.6})
	var small := leaders.size()
	FishingContest.player_caught(&"fish_pike", 2.4, player.global_position)
	await _seconds(0.2)
	var arms_up := 0
	for p: Townsperson in crowd.people():
		if p.is_cheering():
			arms_up += 1
	_check(leaders.size() == 2 and leaders[0] == "young" and leaders[1] == "player" and small == 1,
			"contest17: a cheer goes up at each new biggest fish, the player's too, not for a smaller one (%s)" % str(leaders))
	_check(cheering >= 4 and arms_up >= 1, "contest17: the crowd cheers with them (%d cheering or clapping, %d arms up)" % [cheering, arms_up])
	FishingContest.new_leader.disconnect(on_leader)
	if shots != "":
		var eye := Vector3(c.x + 13.0, 0.0, c.y - 15.0)
		eye.y = TerrainData.height(eye.x, eye.z) + 0.4
		player.global_position = eye
		var look := Vector3(c.x - 1.0, 0.0, c.y + 1.0) - eye
		player.look_at_yaw_pitch(atan2(-look.x, -look.z), deg_to_rad(-12.0))
		await _shot(shots + "/contest17_venue.png")

	# --- 17:00: they walk back round the board and the benches, the broom in his hand ---
	var walkers := crowd.people()
	# (the old men get up off their own benches: those are only walked away from)
	var seats := {}
	for p: Townsperson in walkers:
		for fp: Array in venue.footprints:
			if ContestVenue.crosses(p.global_position, p.global_position, fp, 0.05):
				seats[p] = fp
	var corner := venue.approach[venue.approach.size() - 1]
	player.global_position = corner + Vector3(-2.0, 0.6, 3.0)
	await _seconds(1.0)
	GameClock.minute = 17.0 * 60.0 + 0.5
	await _contest_wait_finished()
	var through: Array[String] = []
	var boy_worst := 0.0
	var boy_frames := 0
	var boy_shown := true
	for k in 100:
		await _seconds(0.1)
		for p: Townsperson in walkers:
			if not is_instance_valid(p) or not p.is_walking_to():
				continue
			var at := p.global_position
			for fp: Array in venue.footprints:
				if seats.get(p) != fp and ContestVenue.crosses(at, at, fp, 0.2):
					through.append("%s at %.1f,%.1f" % [p.person, at.x, at.z])
			if Vector2(at.x, at.z).distance_to(c) < WorldLayout.TOWN_POND_RADIUS + 3.0 and TerrainData.height(at.x, at.z) < WorldLayout.WATER_LEVEL - 0.05:
				through.append("%s in the water" % p.person)
		if is_instance_valid(boy) and boy.is_walking_to() and boy._speed > 0.3 \
				and player.camera.global_position.distance_to(boy.global_position) < 10.0:
			boy_frames += 1
			var off := _c17_broom_off(boy)
			boy_shown = boy_shown and off < INF
			boy_worst = maxf(boy_worst, off if off < INF else 0.0)
		elif is_instance_valid(boy) and boy.is_walking_to():
			# Keep near him (he is animated every frame close by).
			var bpos := boy.global_position
			var to_c := (bpos - Vector3(c.x, bpos.y, c.y)).normalized()
			player.global_position = bpos + to_c * 3.0 + Vector3(0, 0.6, 0)
	_check(through.is_empty(), "contest17: walking back nobody goes through the board, a bench or the water %s" % str(through.slice(0, 4)))
	_check(boy_frames >= 10 and boy_shown and boy_worst < 0.035,
			"contest17: walking back from the pond his broom is in his hand again (%d samples, %.3f m off at most)" % [boy_frames, boy_worst])

	# --- A later contest's goal is quiet ---
	await _seconds(4.0)
	player.global_position = far
	GameClock.day = FishingContest.FIRST_DAY + FishingContest.EVERY_DAYS
	GameClock.minute = 8.0 * 60.0
	Events.day_started.emit(GameClock.day)
	await _seconds(1.0)
	_check(FishingContest.goal_up() and g.quiet, "contest17: a later contest's goal comes up again, quieter")
	FishingContest.testing = false
	await _seconds(1.0)
	_check(not FishingContest.goal_up(), "contest17: no contest goal once there is no contest")
	FishingContest.ceremony_speed = 1.0
	GameClock.day = kept_day
	GameClock.minute = kept_minute
	await _seconds(0.6)


## Why the walk along `way` (world points) is not clear ("" when it is): a leg through
## the board's or a bench's footprint (a body's width round it), a point in the pond's
## water, or anything solid (a tree, a post) at body height along it. The bench `place`
## (a seat: the way's end or start) is in is only walked up to.
func _c17_way_clear(venue: ContestVenue, way: Array[Vector3], space: PhysicsDirectSpaceState3D, sq: PhysicsShapeQueryParameters3D,
		place: Vector3) -> String:
	for i in way.size() - 1:
		var a := way[i]
		var b := way[i + 1]
		for fp: Array in venue.footprints:
			var own := ContestVenue.crosses(place, place, fp, 0.05)
			if own and (a.distance_to(place) < 0.01 or b.distance_to(place) < 0.01):
				continue
			if ContestVenue.crosses(a, b, fp, 0.25):
				return "leg %d (%.1f,%.1f to %.1f,%.1f) through a footprint at %s" % [i, a.x, a.z, b.x, b.z, str(fp[0])]
		var n := maxi(1, ceili(Vector2(a.x, a.z).distance_to(Vector2(b.x, b.z)) / 0.3))
		for k in n + 1:
			var p := a.lerp(b, float(k) / n)
			var h := TerrainData.height(p.x, p.z)
			if Pond.near_water(p, 3.0) and h < WorldLayout.WATER_LEVEL - 0.02:
				return "leg %d in the water at %.1f,%.1f" % [i, p.x, p.z]
			sq.transform = Transform3D(Basis(), Vector3(p.x, h + 1.1, p.z))
			var hits := space.intersect_shape(sq, 1)
			if not hits.is_empty():
				return "leg %d blocked at %.1f,%.1f by %s" % [i, p.x, p.z, (hits[0]["collider"] as Node).name]
	return ""


## How far the shop boy's left fist (as drawn) is off his broom's handle (metres; INF when
## the broom isn't shown).
func _c17_broom_off(p: Townsperson) -> float:
	if p._prop == null or not p._prop.visible:
		return INF
	var sk := p.rig.skeleton
	if sk.has_method(&"force_update_all_bone_transforms"):
		sk.force_update_all_bone_transforms()
	var xf := p._prop.transform
	var axis := xf.basis.y.normalized()
	var g := p.rig.drawn_grip("_l") - xf.origin
	var along := g.dot(axis)
	return maxf((g - axis * along).length(), maxf(0.34 - along, along - 1.48))

# --- Grills ------------------------------------------------------------------------------

## The charcoal grills (Grill): both sold at the town market, put down outdoors, lit with
## E, six and twelve places on the grate (the next fish refused when full), a giant fish
## taking two places side by side (and refused by the campfire, with a message), saved
## and loaded, the 10-second cook into the bag, the grilled giant eaten (it fills more
## than a whole grilled fish), doused (the grill stays) and picked up again cold.
## With -- --grill-shots=/abs/dir it also saves screenshots there.
func _grill() -> void:
	var player: Player = Game.player
	var inv := PlayerState.inventory
	var notes: Array[String] = []
	var on_note := func(text: String, _c: Color) -> void: notes.append(text)
	Events.notification_requested.connect(on_note)
	GameClock.set_time_of_day(19.6)

	# 1. The town market sells both grills; buying them.
	var stock: Array = ShopStock.town_market()["stock"]
	_check(&"grill" in stock and &"big_grill" in stock and Economy.buy_price(&"grill") == 60
			and Economy.buy_price(&"big_grill") == 140, "grill: the town market sells a mangal ($60) and a big grill ($140)")
	Economy.money = 400
	Game.hud.open_shop(ShopStock.town_market())
	await _frames(3)
	var shop: ShopScreen = Game.hud.shop_screen
	shop._set_tab("buy")
	for id: StringName in [&"grill", &"big_grill"]:
		shop._sel = {"id": id, "quality": 0}
		shop._qty = 1
		shop._confirm()
	shop.close_screen()
	await _frames(3)
	_check(inv.count_item(&"grill") == 1 and inv.count_item(&"big_grill") == 1 and Economy.money == 200,
			"grill: both bought into the bag ($%d left of $400)" % Economy.money)

	# 2. Put down outdoors with the placer.
	var grill := await _grill_place(player, &"grill", [Vector2(20, -8), Vector2(24, -12), Vector2(18, -14), Vector2(26, -6)])
	var big := await _grill_place(player, &"big_grill", [Vector2(23, -8), Vector2(17, -8), Vector2(20, -11), Vector2(27, -12)])
	_check(grill != null and big != null and grill.state == "laid" and big.state == "laid",
			"grill: both put down outdoors, laid with charcoal (%s)" % player.placer.reason)
	if grill == null or big == null:
		Events.notification_requested.disconnect(on_note)
		return
	_check(grill._slot_count() == 6 and big._slot_count() == 12 and grill.is_in_group(&"campfires"),
			"grill: six places on the mangal, twelve on the big grill")

	# 3. E lights it.
	_free_hands()
	var front := grill.global_position + grill.global_basis.z * 1.5 + Vector3(0, 0.2, 0)
	player.global_position = front
	await _frames(4)
	_look_at(player, grill.global_position + Vector3(0, 0.72, 0))
	await _frames(6)
	_check(player.target == grill and _last_prompt.contains(tr("ACTION_LIGHT")), "grill: E lights it ('%s')" % _last_prompt)
	await _press_key(KEY_E)
	await _frames(3)
	big.light()
	_check(grill.state == "lit" and big.state == "lit" and is_equal_approx(grill.burn_left, Campfire.BURN_MINUTES),
			"grill: lit, the charcoal burns 5 hours like a campfire")

	# 4. Six fish on the mangal by E; the seventh finds no room.
	inv.set_stack(6, ItemStack.create(&"fish_perch", 20))
	PlayerState.select(6)
	await _frames(4)
	_check(_last_prompt.contains(tr("ACTION_COOK")), "grill: with a raw fish in hand it offers to cook ('%s')" % _last_prompt)
	for i in 7:
		await _press_key(KEY_E)
		await _frames(2)
	_check(grill.cook_status().size() == 6 and inv.count_item(&"fish_perch") == 14 and tr("MSG_CAMPFIRE_FULL") in notes,
			"grill: six fish on the grate, the seventh refused (%d cooking)" % grill.cook_status().size())

	# 5. A giant fish: refused by a campfire, two places side by side on the grill.
	inv.set_stack(5, ItemStack.create(&"fish_carp_trophy", 2))
	PlayerState.select(5)
	var fe := FarmState.add_placed(&"campfire", big.global_position + Vector3(0, 0, 4.0), 0.0)
	fe["state"] = "lit"
	fe["burn_left"] = 240.0
	var fire := Game.world.farm.spawn_placed(fe) as Campfire
	await _frames(3)
	notes.clear()
	fire.interact(player)
	_check(fire.cook_status().is_empty() and inv.count_item(&"fish_carp_trophy") == 2 and tr("MSG_CAMPFIRE_TOO_BIG") in notes
			and fire.hint_prompt().contains(tr("MSG_CAMPFIRE_TOO_BIG")),
			"grill: the campfire refuses a giant fish ('%s')" % ", ".join(notes))
	FarmState.remove_placed(fe)
	fire.queue_free()
	big.interact(player)
	_check(big.cook_status().size() == 1 and int(big._spits[0].get("span", 1)) == 2 and big._spits[1].has("link")
			and inv.count_item(&"fish_carp_trophy") == 1, "grill: the giant takes two places side by side on the big grill")
	_check(not big._span_fits(5, 2) and big._span_fits(6, 2) and not grill._span_fits(2, 2),
			"grill: a giant never straddles the end of a row")
	# Saved with it, and back on the grate on loading.
	var spits: Array = big.entry["spits"]
	var copy := PlacedObject.create(big.entry.duplicate(true)) as Grill
	Game.world.farm.get_node("Placed").add_child(copy)
	await _frames(2)
	_check(spits.size() == 1 and String(spits[0][1]) == "fish_carp_trophy" and copy._spits[1].has("link")
			and copy.cook_status().size() == 1, "grill: the giant is saved on the grate and loads back over two places")
	copy.queue_free()
	# Nine more fish leave one place: a giant doesn't fit, a fish would.
	PlayerState.select(6)
	for i in 9:
		big.interact(player)
	notes.clear()
	PlayerState.select(5)
	big.interact(player)
	_check(big.cook_status().size() == 10 and inv.count_item(&"fish_carp_trophy") == 1 and big._free_spit(1) >= 0
			and tr("MSG_CAMPFIRE_FULL") in notes, "grill: with one place left a second giant finds no room")

	# 6. The cook timer, the look, and everything into the bag.
	await _seconds(2.0)
	var left := float(grill._spits[0]["left"])
	_check(left > 6.5 and left < 8.5, "grill: still cooking two seconds in (%.1f s left)" % left)
	await _grill_shots(player, grill, big)
	await _seconds(float(big._spits[0]["left"]) + 1.5)
	_check(grill.cook_status().is_empty() and big.cook_status().is_empty() and inv.count_item(&"fish_perch_cooked") == 15
			and inv.count_item(&"fish_carp_trophy_cooked") == 1, "grill: after 10 s every fish is grilled and in the bag")

	# 7. The grilled giant fills far more than a whole grilled fish.
	var giant := Eating.food_value(&"fish_carp_trophy_cooked")
	_check(giant > Eating.food_value(&"fish_carp_cooked") * 2 and giant > Eating.food_value(&"fish_perch_cooked"),
			"grill: a grilled giant carp fills %d (a whole grilled carp %d)" % [giant, Eating.food_value(&"fish_carp_cooked")])
	PlayerState.needs.hunger = 5.0
	_select(&"fish_carp_trophy_cooked")
	await _frames(2)
	var ate := Eating.try_eat(player)
	await _seconds(Eating.TIME + 0.5)
	_check(ate and inv.count_item(&"fish_carp_trophy_cooked") == 0 and PlayerState.needs.hunger > 5.0 + giant - 3.0,
			"grill: eaten, it fills the farmer up (hunger %.0f)" % PlayerState.needs.hunger)

	# 8. Doused, the grill stays (cold); F picks it up again.
	grill.douse()
	await _seconds(1.0)
	_check(is_instance_valid(grill) and grill.state == "ash" and FarmState.placed.has(grill.entry) and not grill.is_burning(),
			"grill: doused, the coals go out and the grill stays")
	_check(grill.can_pick_up() and not big.can_pick_up(), "grill: cold and empty it can be picked up; a burning one can't")
	var ge := grill.entry
	grill.info_interact(player)
	await _frames(2)
	_check(inv.count_item(&"grill") == 1 and not FarmState.placed.has(ge) and not is_instance_valid(grill),
			"grill: F puts the cold grill back in the bag")
	Events.notification_requested.disconnect(on_note)


## Selects `id` and walks the candidate spots until the placer shows a valid preview, then
## puts it down: the new grill (null when no spot took it).
func _grill_place(player: Player, id: StringName, spots: Array) -> Grill:
	_select(id)
	for c: Vector2 in spots:
		player.global_position = Vector3(c.x, TerrainData.height(c.x, c.y + 2.6) + 0.3, c.y + 2.6)
		player.look_at_yaw_pitch(0.0, deg_to_rad(-40.0))
		await _frames(8)
		if player.placer.active and player.placer.valid:
			if not player.placer.place():
				return null
			await _frames(3)
			var found: Grill = null
			for n in tree.get_nodes_in_group(&"campfires"):
				if n is Grill and (n as Grill).item_id == id:
					found = n
			return found
	return null


## Both grills lit at dusk with food on them, the giant on the big one (only with
## -- --grill-shots=/abs/dir).
func _grill_shots(player: Player, grill: Grill, big: Grill) -> void:
	if not DebugTools.args.has("grill-shots"):
		return
	var dir := String(DebugTools.args["grill-shots"])
	DirAccess.make_dir_recursive_absolute(dir)
	var hud_was := Game.hud.visible
	Game.hud.visible = false
	var held := PlayerState.selected
	for i in PlayerState.HOTBAR_SIZE:
		if PlayerState.inventory.get_stack(i) == null:
			PlayerState.select(i)
			break
	var mid := (grill.global_position + big.global_position) * 0.5
	var away := (grill.global_basis.z + big.global_basis.z).normalized()
	var views := [
		["grills_dusk", mid + away * 2.6, mid + Vector3(0, 0.75, 0)],
		["big_grill_giant", big.global_position + big.global_basis.z * 1.1, big.global_position + Vector3(0, 0.85, 0)],
		["mangal_close", grill.global_position + grill.global_basis.z * 0.9 + grill.global_basis.x * 0.3, grill.global_position + Vector3(0, 0.74, 0)],
	]
	for v: Array in views:
		var at: Vector3 = v[1]
		player.global_position = Vector3(at.x, TerrainData.height(at.x, at.z) + 0.05, at.z)
		await _frames(3)
		_look_at(player, v[2])
		await _seconds(0.5)
		await _idle_frames(4)
		player.get_viewport().get_texture().get_image().save_png("%s/%s.png" % [dir, v[0]])
	Game.hud.visible = hud_was
	PlayerState.select(held)



# --- The farmer's own dog (Pet, PetDog) -----------------------------------------------------------

## Karamel's pup given to the farmer (Pet.adopt): named in the prompt, beside him at a
## pup's size and proportions; following him; the whistle (now and then unheeded by the
## pup, seeded; hardly ever grown); "sit" learnt after a few practices (command + pat),
## not by pats alone nor late ones; the market's ball thrown, played with by the young
## pup, brought back to his feet once old enough and taught; growing by the day; its bed
## at night (and on watch grown); a grown dog on guard halving a raid's losses in a seeded
## sleep simulation; saved and loaded. -- --pet-shots=<dir> also saves screenshots.
func _scenario_pet() -> void:
	await _close_screens()
	var player: Player = Game.player
	if player.driving:
		player.exit_vehicle()
		await _frames(5)
	var shots := String(DebugTools.args.get("pet-shots", ""))
	if shots != "":
		DirAccess.make_dir_recursive_absolute(shots)
	Weather.force(Weather.Kind.SUNNY)
	GameClock.set_time_of_day(10.0)
	Pet.load_data({})
	var notes: Array[String] = []
	var on_note := func(text: String, _c: Color) -> void: notes.append(text)
	Events.notification_requested.connect(on_note)
	var spot := _on_ground(Vector2(-9.0, -3.0))
